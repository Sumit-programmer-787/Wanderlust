 <% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3><%= listing.title %></h3>
  </div>

  <div class="card col-6 offset-2 show-card listing-card">
    <div class="card show-card">
      <img 
        src="<%= listing.image.url %>" 
        class="card-img-top show-img"
        alt="listing_image"
      />

      <div class="card-body ">
        <p class="card-text">Owned by <i><%= listing.owner ? listing.owner.username : "Unknown" %></i></p>
          <b><%= listing.title %></b><br>
          <%= listing.description %> <br>
          &#8377; <%= listing.price.toLocaleString("eng-IN") %> <br />
         <p class="card-text"> <%= listing.location %> <br></p>
          <p class="card-text"> <%= listing.country %></p>
      </div>
    </div>

    <% if(currUser && listing.owner && currUser._id.equals(currUser._id)) { %>
    <div class="btns d-flex gap-3 mt-3 mb-4">
      <a 
        href="/listings/<%= listing._id %>/edit" 
        class="btn btn-dark col-2 edit-btn">Edit</a>

      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0">
        <button class="btn btn-dark offset-5">Delete</button>
      </form>
      </div>
      
    </div>
</div>


<% } %> <% if(currUser) {%>
<div class="row">
  <div class="col-8 offset-2 mb-3">
    <hr />
    <h4>Leave a Review</h4>
    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">

      <div class="mb-3 mt-3">
        <label for="rating">Rating</label>
        <input 
        type="range" 
        min="1" 
        max="5" 
        id="rating" 
        name="review[rating]"
        class="form-range"
        >
      </div>
      
      <fieldset class="starability-slot">
  <legend>First rating:</legend>
  <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="rating" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="rating" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="rating" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="rating" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="rating" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea 
        name="review[comment]" 
        id="comment" 
        cols="30" 
        rows="5" 
        class="form-control"
        required
        ></textarea>
        <div class="ivalid-feedback">Please add some comments for review</div>
      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>

    <hr />
    <% } %>
    
    <p><b>All Reviews</b></p>
    <div class="row">
      <% for(review of listing.reviews) { %>
        <div class="card col-5 ms-3 mb-3">
          <div class="card-body">
            <h5 class="card-title">@<%= review.author.username %></h5>
            <p class="card-text"><%= review.comment%></p>
            <p class="card-text"><%= review.rating %>stars</p>
            <p class="starability-result" data-rating="3">
              Rated 3 stars
            </p>
            <form
           class="mb-3"
           method="POST"
           action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
  <button class="btn btn-sm btn-dark">Delete</button>
</form>
          </div>
        </div>
       <% } %> 
    </div>
  </div>
</div>